    "#-- logistic regression pipeline--\n",
    "logistic= pipeline.Pipeline([\n",
    " (\"scaler\", StandardScaler()),\n",
    " (\"logistic\", LogisticRegression(class_weight=\"balanced\", max_iter=1000, random_state=212))\n",
    "])\n",
