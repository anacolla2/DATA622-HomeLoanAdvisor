    "#-- histogram gradient boosting classifier--\n",
    "hgb= HistGradientBoostingClassifier(max_iter=100, learning_rate=0.07, max_leaf_nodes=40, l2_regularization=0.1, random_state=212, class_weight=\"balanced\")\n",
    "\n",
    "#-- fitting--\n",
    "hgb.fit(x_train, y_train)\n",
    "\n",
    "#-- predictions--\n",
    "hgb_pred= hgb.predict(x_test)\n",
    "hgb_prob= hgb.predict_proba(x_test)[:, 1]\n",
    "\n",
    "#-- evaluation--\n",
    "hgb_auc= roc_auc_score(y_test, hgb_prob)\n",
    "\n",
    "print(classification_report(y_test, hgb_pred))\n",
    "print(f\"Hist Gradient Boosting ROC-AUC: {hgb_auc:.4f}\")\n",
    "\n",
    "#-- sample test data for hgb permutation importance--- a sample --\n",
    "hgb_sample= x_test.sample(n=50000, random_state=212)\n",
    "y_sample= y_test.loc[hgb_sample.index]\n",
    "\n",
    "#-- permutation importance for histogram gradient boosting--\n",
    "hgb_perm= permutation_importance(hgb, hgb_sample, y_sample, scoring=\"roc_auc\", n_repeats=3, random_state=212, n_jobs=1)\n",
    "\n",
    "#-- feature importance table--\n",
    "hgb_importance= pd.DataFrame({\n",
    "  \"variable\": hgb_sample.columns,\n",
    "  \"importance\": hgb_perm.importances_mean,\n",
    "  \"importance_std\": hgb_perm.importances_std\n",
    "}).sort_values(\"importance\", ascending=False)\n",
    "\n",
    "hgb_importance.head(20)"
   ]
